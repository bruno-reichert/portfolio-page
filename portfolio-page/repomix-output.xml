  border: 1px solid var(--border);
  padding: 6px 12px;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.note-icon {
  font-weight: 700;
}

/* Certifications Ledger Table Layout */
.certs-table {
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
  background-color: var(--bg);
  transition: var(--transition-theme);
}

/* Individual spreadsheet-style row representation */
.cert-row {
  display: grid;
  grid-template-columns: 140px 1fr 140px; /* Layout columns widths */
  border-bottom: 1px solid var(--border);
  transition: background-color 0.15s ease;
}

.cert-row:last-child {
  border-bottom: none; /* Clear bottom border of last table item */
}

/* Hovering shifts row background, mimicking tracking spreadsheet entries */
.cert-row:hover {
  background-color: var(--bg-alt);
}

.cert-col {
  padding: 20px 24px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* Column Type Settings */
.cert-date {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--ink-muted);
  border-right: 1px solid var(--border);
}

.cert-info {
  align-items: flex-start;
}

.cert-title {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 4px;
}

.cert-link {
  text-decoration: none;
  color: var(--ink);
  transition: color 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.cert-link:hover {
  color: var(--accent);
}

.cert-link-arrow {
  font-size: 0.85rem;
  color: var(--accent-alt);
}

.cert-description {
  font-family: var(--font-body);
  font-size: 0.95rem;
  color: var(--ink-muted);
}

/* Badging Status Area Column */
.cert-status {
  align-items: flex-end;
  border-left: 1px solid var(--border);
}

.badge {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 700;
  padding: 4px 8px;
  border-radius: 4px;
  text-align: center;
  letter-spacing: 0.02em;
}

.badge.completed {
  background-color: var(--bg);
  color: var(--accent);
  border: 1px solid var(--accent);
}

.badge.progress {
  background-color: var(--accent-alt);
  color: var(--bg);
  border: 1px solid var(--accent-alt);
}

/* Responsive Collapse rules for tablet and phone dimensions */
@media (max-width: 768px) {
  .cert-row {
    grid-template-columns: 1fr; /* Switch columns structure to linear vertical block */
  }

  .cert-col {
    padding: 12px 16px;
    border: none !important; /* Clear nested vertical borders inside card block */
  }

  .cert-date {
    padding-bottom: 0;
    font-size: 0.8rem;
    color: var(--accent);
  }

  .cert-status {
    align-items: flex-start; /* Left align badge indicators */
    padding-top: 0;
  }

  .certs-heading {
    font-size: 2rem;
  }
}

/* Contact Grid Configuration */
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 2fr; /* 1/3 layout for info, 2/3 for interactive links */
  gap: 48px;
  margin-top: 16px;
  align-items: start;
}

.contact-heading {
  font-family: var(--font-display);
  font-size: 2.5rem;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 24px;
}

/* Location Record Box */
.location-badge {
  display: flex;
  align-items: center;
  gap: 16px;
  background-color: var(--bg-alt);
  border: 1px solid var(--border);
  padding: 16px;
  border-radius: 6px;
  max-width: 320px;
  transition: var(--transition-theme);
}

.location-icon {
  font-size: 1.5rem;
}

.location-details {
  display: flex;
  flex-direction: column;
}

.location-label {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: 0.05em;
}

.location-value {
  font-family: var(--font-body);
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--ink);
}

/* Interactive Direct Links Area */
.contact-links-col {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.contact-row-link {
  display: flex;
  align-items: baseline;
  gap: 16px;
  border-bottom: 1px dashed var(--border);
  padding-bottom: 12px;
}

.contact-row-link:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

/* Monospace command prefixes */
.contact-command {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--accent);
  min-width: 80px;
  user-select: none;
}

/* Hyperlink styling and scaling animations */
.contact-address-link {
  font-family: var(--font-body);
  font-size: 1.25rem;
  font-weight: 600;
  text-decoration: none;
  color: var(--ink);
  transition: color 0.2s ease, transform 0.2s ease;
  display: inline-block;
}

.contact-address-link:hover {
  color: var(--accent-alt);
  transform: translateX(4px); /* Shifts slightly to the right to register motion */
}

/* Responsive Collapse structures for mobile viewports */
@media (max-width: 768px) {
  .contact-grid {
    grid-template-columns: 1fr; /* Shift layout to stack vertically */
    gap: 32px;
  }

  .contact-heading {
    font-size: 2rem;
    margin-bottom: 16px;
  }

  .location-badge {
    max-width: 100%; /* Spans full width on mobile devices */
  }

  .contact-row-link {
    flex-direction: column; /* Stacks command name above link addresses on small screens */
    gap: 4px;
  }

  .contact-address-link {
    font-size: 1.1rem;
    word-break: break-all; /* Prevents long emails/links from clipping layout bounds */
  }
}

/* Footer Structural Container */
.site-footer {
  border-top: 1px solid var(--border);
  background-color: var(--bg);
  transition: var(--transition-theme);
}

.footer-container {
  max-width: 1120px;
  margin: 0 auto;
  padding: 32px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* Typography styles */
.copyright-text {
  font-family: var(--font-body);
  font-size: 0.85rem;
  color: var(--ink-muted);
}

/* Monospace Back-to-Top trigger */
.back-to-top-link {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  text-decoration: none;
  color: var(--ink-muted);
  display: flex;
  align-items: center;
  gap: 8px;
  transition: color 0.2s ease;
}

.footer-arrow {
  font-size: 0.7rem;
  color: var(--accent);
}

.back-to-top-link:hover {
  color: var(--ink);
}

.back-to-top-link:hover .footer-arrow {
  color: var(--accent-alt);
}

/* Responsiveness adjustments for phones */
@media (max-width: 640px) {
  .footer-container {
    flex-direction: column-reverse; /* Stacks text vertically on mobile with links on top */
    gap: 16px;
    padding: 24px 16px;
  }
}
</file>

<file path="src/App.jsx">
import React from 'react';
import { useTheme } from './hooks/useTheme';
import { useLanguage } from './hooks/useLanguage';

// Import component shells
import Header from './components/Header';
import Hero from './components/Hero';
import About from './components/About';
import Projects from './components/Projects';
import Certifications from './components/Certifications';
import Contact from './components/Contact';
import Footer from './components/Footer';

// Styling
import './App.css';

function App() {
  const { theme, toggleTheme } = useTheme();
  const { language, toggleLanguage } = useLanguage();

  return (
    <>
      {/* 
        The Header receives the theme/language state and their toggle functions
        so the user can interact with the switch controls.
      */}
      <Header 
        theme={theme} 
        toggleTheme={toggleTheme} 
        language={language} 
        toggleLanguage={toggleLanguage} 
      />
      
      {/* Main layout container wrapping all sections sequentially */}
      <main>
        <Hero language={language} />
        <About language={language} />
        <Projects language={language} />
        <Certifications language={language} />
        <Contact language={language} />
      </main>

      <Footer language={language} />
    </>
  );
}

export default App;
</file>

